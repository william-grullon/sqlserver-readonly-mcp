# Copy to .env and set real values. .env is gitignored.
# SQL Server requires strong passwords: 8+ chars, upper, lower, digit, symbol.

MSSQL_SA_PASSWORD=ChangeMe_Sa_1!
MCP_READER_PASSWORD=ChangeMe_Reader_1!
MSSQL_PORT=14333

# Used by the MCP server and the tests (read-only login, never sa)
HARBOR_MCP_CONNECTION=Server=localhost,14333;Database=HarborSupply;User Id=mcp_reader;Password=ChangeMe_Reader_1!;TrustServerCertificate=True;Encrypt=True

# Optional server limits
HARBOR_MCP_ROW_CAP=500
HARBOR_MCP_TIMEOUT_SECONDS=15
HARBOR_MCP_AUDIT_LOG=logs/audit.jsonl
